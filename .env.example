# Copy this file to .env and fill in real values. NEVER commit .env (it's gitignored).
# Share real keys with teammates through a private channel (DM / password manager), not git.

# ClickHouse (the FEC database)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=donor_agent

# Nimble (live web enrichment)
NIMBLE_API_KEY=

# Senso (publish cited records) — only if we keep this tool
SENSO_API_KEY=

# LLM for the NL ask parser
ANTHROPIC_API_KEY=
